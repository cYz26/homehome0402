{
  "name": "homehome-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:model": "node scripts/check-model.mjs",
    "model:build": "node scripts/blender-step.mjs model",
    "model:export": "node scripts/blender-step.mjs export",
    "model:render": "node scripts/blender-step.mjs render",
    "model:validate": "node scripts/blender-step.mjs validate",
    "assets:data": "node scripts/generate-data.mjs",
    "assets:optimize": "node scripts/optimize-web.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "site:stage": "node scripts/stage-site.mjs",
    "predev": "npm run site:stage",
    "prebuild": "npm run site:stage",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:release": "node scripts/check-release.mjs",
    "check:worker": "node scripts/check-worker.mjs",
    "worker:dev": "wrangler dev --local --ip 127.0.0.1",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .asset-work/tmp/worker",
    "worker:deploy": "wrangler deploy",
    "worker:secrets": "node scripts/worker-secrets.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "meshoptimizer": "^1.2.0",
    "polygon-clipping": "^0.15.7",
    "sharp": "^0.35.4",
    "vite": "^7.1.7",
    "wrangler": "4.148.0"
  }
}
